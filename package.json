{
  "name": "workspace",
  "version": "1.0.0",
  "description": "Private product and business operations management",
  "main": "server/index.ts",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "vite build && tsc --noEmit",
    "start": "NODE_ENV=production tsx server/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "tsx --test",
    "test:quote-print": "tsx --test src/components/customer-quote-print.test.ts",
    "test:payment-posting": "RUN_PAYMENT_POSTING_INTEGRATION=1 tsx --test server/payment-posting.integration.test.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@clerk/express": "^2.1.85",
    "@clerk/react": "^6.18.3",
    "@clerk/shared": "^4.43.0",
    "@clerk/themes": "^2.4.57",
    "@replit/connectors-sdk": "^0.7.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.11",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "http-proxy-middleware": "^4.2.1",
    "lucide-react": "^1.64.0",
    "pg": "^8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "wouter": "^3.13.0",
    "zod": "^4.6.7"
  }
}
